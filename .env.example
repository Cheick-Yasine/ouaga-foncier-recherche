# Copiez ce fichier en .env puis remplacez uniquement les valeurs localement.
# Ne publiez jamais vos véritables secrets.
DATABASE_URL=postgresql://UTILISATEUR:MOT_DE_PASSE@HOTE/BASE?sslmode=require
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_CANDIDATE_LIMIT=30
LLM_RELEVANCE_THRESHOLD=55

APP_ENV=development
# Facultatif : décommentez pour imposer une limite exceptionnelle.
# MAX_AD_AGE_DAYS=30
